# Local mirror of Replit's env structure. `cp .env.example .env`, fill the two
# keys yourself. .env is gitignored — keys never go in git or chat.
# Load pattern per terminal:  set -a; source .env; set +a

# ── Replit SECRETS equivalents (fill locally, values live only in your .env) ──
FIREWORKS_API_KEY=
ANTHROPIC_API_KEY=

# ── Local infrastructure (Replit provides these implicitly) ──
DATABASE_URL=postgres://localhost:5432/sheaf_dev
ANALYZER_URL=http://127.0.0.1:8000
# Analyzer's one door back into the portal (Replit default is :80/api):
PORTAL_API_BASE=http://127.0.0.1:3001/api

# ── Same values as .replit [userenv.shared] ──
PARSE_BACKEND=paddle
PARSE_MODEL=claude-sonnet-4-6
PADDLE_VL_URL=https://api.fireworks.ai/inference/v1
PADDLE_VL_MODEL=accounts/creditclaw/deployments/p4tlc3h1
TEXT_BACKEND=fireworks
TEXT_MODEL=accounts/fireworks/models/glm-5p2
RUN_TIMEOUT_S=1800

# Judge defaults (config.py): JUDGE_BACKEND=anthropic, JUDGE_MODEL=claude-sonnet-4-6
# PORT is deliberately NOT here — it's per-service: api-server 3001, client 5173.

modules = ["nodejs-24", "python-3.12", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Analyzer Worker"

[[workflows.workflow]]
name = "Analyzer Worker"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash services/analyzer/run.sh"
waitForPort = 8000

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["openssl", "zlib"]

[userenv]

[userenv.shared]
ANALYZER_URL = "http://127.0.0.1:8000"
PARSE_BACKEND = "paddle"
PARSE_MODEL = "claude-sonnet-4-6"
PADDLE_VL_MODEL = "accounts/creditclaw/deployments/p4tlc3h1"
PADDLE_VL_URL = "https://api.fireworks.ai/inference/v1"
RUN_TIMEOUT_S = "1800"
TEXT_BACKEND = "fireworks"
TEXT_MODEL = "accounts/fireworks/models/glm-5p2"
